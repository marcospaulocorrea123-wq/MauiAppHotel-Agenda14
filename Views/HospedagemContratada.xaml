<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             BackgroundColor="#0F141C">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <!-- Card Principal com o Resumo -->

            <Border Stroke="#E3A857"
                    StrokeThickness="1"
                    BackgroundColor="#1F2430"
                    Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Hospedagem Confirmada!"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#E3A857"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#2E3440" Margin="0,5" />

                    <!-- Informações da Acomodação -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Acomodação Escolhida:"
                               FontSize="13"
                               TextColor="#A0A5B5" />
                        <Label Text="{Binding QuartoSelecionado.Descricao}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF" />
                        <Label Text="{Binding QuartoSelecionado.Beneficios, StringFormat='Incluso: {0}'}"
                               FontSize="12"
                               FontAttributes="Italic"
                               TextColor="#E3A857" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#2E3440" Margin="0,5" />

                    <!-- Quantidade de Hóspedes -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" TextColor="#A0A5B5" FontSize="14" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding QntAdultos}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" TextColor="#A0A5B5" FontSize="14" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding QntCriancas}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E3440" Margin="0,5" />

                    <!-- Período da Estadia -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="#A0A5B5" FontSize="14" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding DataCheckin, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#FFFFFF" FontSize="14" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" TextColor="#A0A5B5" FontSize="14" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckout, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#FFFFFF" FontSize="14" HorizontalOptions="End" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Total de Diárias:" TextColor="#A0A5B5" FontSize="14" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Estadia, StringFormat='{0} dia(s)'}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2E3440" Margin="0,5" />

                    <!-- Valor Total Calculado -->
                    <VerticalStackLayout Spacing="5" Margin="0,10,0,0">
                        <Label Text="Valor Total da Hospedagem"
                               FontSize="14"
                               TextColor="#A0A5B5"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#E3A857"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Botão para Retornar / Fazer Nova Reserva -->
            <Button Text="Fazer Nova Simulação"
                    Clicked="BtnVoltar_Clicked"
                    BackgroundColor="#E3A857"
                    TextColor="#0F141C"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>