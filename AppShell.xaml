<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAppHotel.Views"
    Title="App Hotel"
    FlyoutBehavior="Flyout">

    <!-- Item 1: Tela Principal de Reserva -->
    <FlyoutItem Title="Hospedagem">
        <ShellContent
            Title="Hospedagem"
            ContentTemplate="{DataTemplate views:ContratacaoHospedagem}"
            Route="ContratacaoHospedagem" />
    </FlyoutItem>

    <!-- Item 2: Tela Sobre -->
    <FlyoutItem Title="Sobre o Desenvolvedor">
        <ShellContent
            Title="Sobre"
            ContentTemplate="{DataTemplate views:SobrePage}"
            Route="SobrePage" />
    </FlyoutItem>

</Shell>